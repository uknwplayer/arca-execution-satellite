{
  "schema": "arca.execution-provider.v0.1",
  "executor_id": "github-public-linux",
  "provider_family": "github-git-queue",
  "trust_state": "EXPERIMENTAL_VERIFIED",
  "admission_state": "LAB_ADMITTED",
  "visibility": "public",
  "capabilities": [
    "python.runtime",
    "os.linux",
    "artifact.upload",
    "sha256",
    "profile.smoke",
    "profile.python-unit"
  ],
  "queue_prefix": "queue/requests",
  "restrictions": {
    "arbitrary_shell_input": false,
    "private_repository_material": false,
    "secrets": false,
    "core_mutation": false,
    "core_promotion": false
  }
}
